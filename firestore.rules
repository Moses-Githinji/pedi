rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Users shouldn't delete their own accounts directly without a function
    }
    match /gems/{gemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Refine later for only creator or specific fields
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
      
      match /votes/{voteId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null; // Votes handled securely via Cloud Functions or strict rules
      }
    }
  }
}
